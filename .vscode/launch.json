{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TodoApi (.NET)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/backend/TodoApi/bin/Debug/net10.0/TodoApi.dll",
            "cwd": "${workspaceFolder}/backend/TodoApi",
            "args": [
                "--urls",
                "http://localhost:5000"
            ],
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build TodoApi",
            "stopAtEntry": false
        },
        {
            "name": "todo-web (Vite + Chrome)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/todo-web",
            "preLaunchTask": "start todo-web"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "TodoApp (backend + frontend)",
            "configurations": [
                "TodoApi (.NET)",
                "todo-web (Vite + Chrome)"
            ],
            "stopAll": true
        }
    ]
}